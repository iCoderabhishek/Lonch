(strict_security) {
    # =====================================================
    # LAYER 1: Block known attack tools & scanners
    # Even if they spoof a browser UA, many still leak their
    # real identity in the UA string. Catch them early.
    # =====================================================
    @attack_tools {
        header_regexp User-Agent "(?i)(curl|wget|python|httpx|nuclei|zgrab|masscan|nmap|nikto|sqlmap|dirbuster|gobuster|wfuzz|ffuf|burpsuite|acunetix|nessus|qualys|openvas|arachni|w3af|skipfish|wpscan|droopescan|whatweb|wafw00f|xsstrike|commix|semrush|ahref|mj12bot|dotbot|petalbot|baiduspider|yandexbot|sogou|exabot|go-http-client|java|libwww|lwp-trivial|scrapy|mechanize|httpclient|okhttp|axios|node-fetch|undici|got\/|superagent)"
    }
    abort @attack_tools

    # =====================================================
    # LAYER 2: Require REAL browser User-Agent
    # Every modern browser (Chrome, Firefox, Safari, Edge)
    # sends "Mozilla/5.0 (" — this is a hard whitelist.
    # Bots that don't perfectly mimic this prefix are dropped.
    # Webhooks & health checks are excluded.
    # =====================================================
    @no_ua not header User-Agent *
    abort @no_ua

    @not_real_browser {
        not header_regexp User-Agent "^Mozilla/5\.0 \("
        not path /api/v1/webhooks/*
        not path /health*
    }
    abort @not_real_browser

    # =====================================================
    # LAYER 3: Origin / Referer validation for API routes
    # Browsers automatically set the Origin header on
    # cross-origin requests. Even a bot with a perfect
    # spoofed UA will NOT have an Origin from lonch.cloud
    # unless they explicitly forge it — and at that point
    # they need to know your exact domain, which filters
    # out 99.9% of automated scanners.
    # Webhooks are excluded (GitHub sets its own headers).
    # =====================================================
    @api_no_origin {
        path /api/v1/*
        not path /api/v1/webhooks/*
        not path /api/v1/auth/*
        not header_regexp Origin "(?i)lonch\."
        not header_regexp Referer "(?i)lonch\."
    }
    abort @api_no_origin

    # =====================================================
    # LAYER 4: Secret X-App-Key header
    # The frontend sends this secret in every API request.
    # Even if a bot forges UA + Origin, it still can't pass
    # this check unless it knows the secret key.
    # This is the STRONGEST proxy-level defense.
    # Webhooks, health, and non-API routes are excluded.
    # =====================================================
    @api_no_key {
        path /api/v1/*
        not path /api/v1/webhooks/*
        not path /api/v1/auth/*
        not header X-App-Key "{$APP_SECRET_KEY}"
    }
    abort @api_no_key
}

# =====================================================
# CATCH-ALL: Abort requests to raw IP or unknown hosts
# Bots that hit the server by IP instead of domain
# get immediately dropped.
# =====================================================
http:// {
    abort
}

http://api.lonch.cloud {
    import strict_security
    reverse_proxy app:8080 {
        header_up X-Forwarded-Proto {scheme}
    }
}

http://*.lonch.cloud {
    import strict_security
    reverse_proxy app:8080 {
        header_up X-Forwarded-Proto {scheme}
    }
}
