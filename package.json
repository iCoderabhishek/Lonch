{
  "name": "lonch",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/app",
    "start": "./dist/app",
    "generate": "bunx --bun prisma generate",
    "migrate": "bunx --bun prisma migrate dev",
    "studio": "bunx --bun prisma studio",
    "docker": "bunx --bun docker-compose up --build -d",
    "docker:down": "bunx --bun docker-compose down",
    "generate-string": "bun ./src/shared/scripts/long-string-generation.ts",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/mime-types": "^3.0.1",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1106.0",
    "@aws-sdk/client-ec2": "^3.1106.0",
    "@aws-sdk/client-ecr": "^3.1106.0",
    "@aws-sdk/client-ecs": "^3.1106.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/lib-storage": "^3.1104.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-session": "^2.0.49",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "author": "Abhishek Jha",
  "description": "A cloud deployment platform that provide static and backend deployment services."
}